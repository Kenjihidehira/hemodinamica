# Copie para .env.local (que não vai para o git) e preencha.
# Chave da API da Anthropic usada pelo copilot do médico na hemodinâmica.
ANTHROPIC_API_KEY=
# Opcional: modelo do copilot (padrão claude-opus-5-5).
HEMO_COPILOT_MODEL=

# Backend no Supabase (docs/backend-supabase.md). Ainda não usado pela tela: falta o login pelo Supabase Auth.
# A chave publicável pode ir para o navegador; nunca coloque a service_role aqui.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
